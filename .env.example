SEO_PUBLIC_URL=https://seo.example.com
SEO_ADMIN_USER=admin
SEO_ADMIN_PASSWORD=replace-with-a-long-random-password
SEO_BIND=127.0.0.1
PORT=8787
SEO_DB_PATH=data/seo.sqlite
SEO_GITHUB_TOKEN=
SEO_GITHUB_TARGETS='{"https://bubora.online":{"repo":"curlycoder25/bubora-lms","branch":"main","routes":{"/":"index.html"}}}'
SEO_LIVE_TARGETS='{}'

# Google Search Console: service account JSON (single-line JSON); grant this email access in Search Console
SEO_GSC_SERVICE_ACCOUNT_JSON=
# Optional AI generation: paid API key, kept on server only
SEO_OPENAI_API_KEY=
SEO_AI_MODEL=gpt-4.1-mini
# Server-side scheduled SEO homepage audits (hours 6..168)
SEO_AUTO_AUDIT_ENABLED=false
SEO_AUTO_AUDIT_HOURS=24
